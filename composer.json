{
  "name": "panelis-php/location",
  "description": "Manage countries, regions, and cities used by the application",
  "keywords": [
    "panelis"
  ],
  "authors": [
    {
      "name": "Yugo",
      "email": "dedy.yugo.purwanto@gmail.com"
    }
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "illuminate/support": "^13.0",
    "filament/filament": "^5.0",
    "panelis-php/activity": "^1.1"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pint": "^1.29",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^4.4",
    "pestphp/pest-plugin-laravel": "^4.1"
  },
  "scripts": {
    "test": "vendor/bin/pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "autoload": {
    "psr-4": {
      "Panelis\\Location\\": "src/",
      "Panelis\\Location\\Database\\Factories\\": "database/factories/",
      "Panelis\\Location\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Panelis\\Location\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Panelis\\Location\\Providers\\LocationServiceProvider"
      ]
    },
    "panelis": {
      "plugins": [
        "Panelis\\Location\\Plugins\\LocationPlugin"
      ],
      "permissions": {
        "country": "Panelis\\Location\\Panel\\Resources\\CountryResource\\Enums\\CountryPermission",
        "district": "Panelis\\Location\\Panel\\Resources\\DistrictResource\\Enums\\DistrictPermission",
        "region": "Panelis\\Location\\Panel\\Resources\\RegionResource\\Enums\\RegionPermission"
      }
    }
  }
}
